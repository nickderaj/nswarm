{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nickderaj/nswarm/fixtures/gym/intent-v1.schema.json",
  "title": "nswarm gym parity intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "at", "kilograms"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "log_body_weight"},
    "at": {"type": "string", "format": "date-time"},
    "kilograms": {"type": "number", "exclusiveMinimum": 0}
  }
}
